# Copy to .env and fill in once real agent endpoints exist.
# The mock adapter (lib/agents/mock.ts) needs none of this to run.

REDIS_URL=redis://redis:6379

# Uncomment and point at real bridges once you build them:
# AGENTCTRL_HERMES_URL=http://hermes-bridge:8080
# AGENTCTRL_CODEX_URL=http://codex-bridge:8081
# AGENTCTRL_OPENCLAW_URL=http://openclaw-bridge:8082

# Optional password gate (middleware.ts). Unset by default — fine when the
# dashboard only lives on your Tailscale tailnet. Set this before exposing
# it via a Cloudflare Tunnel or any path reachable off your tailnet.
# AGENTCTRL_PASSWORD=change-me

# Copy to .env and fill in as needed. The mock adapter (lib/agents/mock.ts)
# needs none of this to run — everything below is opt-in.

REDIS_URL=redis://redis:6379

# Data source for the dashboard:
#   unset (default) -> mock adapter, fully synthetic, zero setup
#   redis           -> reads harnesses/example-agent-harness (or any real
#                      bridge you write) publishing into Redis. Start the
#                      demo harnesses with `docker compose --profile demo up -d`
#                      first, then set this and restart the agentctrl service.
# AGENTCTRL_ADAPTER=redis

# Optional password gate (middleware.ts). Unset by default — fine when the
# dashboard only lives on your Tailscale tailnet. Set this before exposing
# it via a Cloudflare Tunnel or any path reachable off your tailnet.
# AGENTCTRL_PASSWORD=change-me

# Optional shared-secret check for agent-written journal entries
# (POST /api/journal). Unset by default (open on your tailnet, same as
# everything else). Set this once real agent processes are posting entries
# and you want a real check even without AGENTCTRL_PASSWORD turned on.
# AGENTCTRL_AGENT_TOKEN=some-random-string

# --- Obsidian vault sync (lib/vault/sync.ts) --------------------------------
# Unset by default — the scheduler stays idle and /settings shows
# "Not configured" until you set at least OBSIDIAN_VAULT_REPO.
#
# Create an EMPTY repo on GitHub first (same as AgentCtrl's own repo), then:
#   OBSIDIAN_VAULT_REPO  - https URL of that repo, e.g.
#                          https://github.com/you/agentctrl-vault.git
#   OBSIDIAN_VAULT_TOKEN - fine-grained PAT, Contents: read/write, scoped to
#                          ONLY that vault repo (not AgentCtrl's own repo!).
#                          Without this set, the vault syncs locally inside
#                          the container but is never pushed anywhere.
#
# Every Project/Journal entry/Chat thread is regenerated as markdown and
# committed+pushed automatically every 10 minutes (only if something
# changed), plus on-demand via the "Sync now" button in
# Settings > Obsidian Vault.
# OBSIDIAN_VAULT_REPO=https://github.com/you/agentctrl-vault.git
# OBSIDIAN_VAULT_TOKEN=github_pat_xxx
# OBSIDIAN_VAULT_GIT_NAME=AgentCtrl Vault Sync
# OBSIDIAN_VAULT_GIT_EMAIL=vault-sync@agentctrl.local

# AGENTCTRL_AGENT_TOKEN (see above) also gates POST /api/usage and
# POST /api/approvals the same way it gates POST /api/journal — all three
# are the machine-to-machine write paths a real bridge would call.
